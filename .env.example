# ==============================================================================
# SKYNEXA FLIGHT BOOKING ENGINE — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# ------------------------------------------------------------------------------
# Backend Configuration (backend/.env)
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# MongoDB Atlas Connection URI (Replace with your database connection string)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/skynexa?retryWrites=true&w=majority

# JSON Web Token Configuration
JWT_SECRET=your_super_secret_jwt_key_here_min_32_chars
JWT_EXPIRE=7d

# Session & Cookie Configuration
SESSION_SECRET=your_session_secret_key_here

# Email / Notification Provider (Resend API - Optional in local demo)
RESEND_API_KEY=re_your_resend_api_key_here
EMAIL_FROM=onboarding@resend.dev

# Payment Gateway Configuration (Optional - Skynexa includes an integrated Demo Provider)
PAYMENT_PROVIDER_KEY=
PAYMENT_PROVIDER_SECRET=

# ------------------------------------------------------------------------------
# Frontend Configuration (frontend/.env)
# ------------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:5000/api
